# Jarvis configuration — copy to `.env` and fill in.
# `.env` is gitignored. NEVER commit real secrets.
# Only secrets/keys live here; non-secret choices live in jarvis/config/defaults.toml
# (or override any setting with a JARVIS_ environment variable).

# --- LLM providers (pick one; model is chosen in defaults.toml) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For a fully-local brain via Ollama, no key is needed; set the model in defaults.toml
# to something like "ollama/llama3.1" and run Ollama locally.

# --- Knowledge & web skills ---
OPENWEATHER_API_KEY=
NEWS_API_KEY=

# --- Comms & media ---
# Use a Gmail App Password (https://support.google.com/accounts/answer/185833),
# NOT your account password.
JARVIS_EMAIL=
JARVIS_EMAIL_PASSWORD=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# --- Voice (Phase 2) ---
ELEVENLABS_API_KEY=
PORCUPINE_ACCESS_KEY=

# --- Messaging bots (Phase 4) ---
# Get a token from @BotFather. Optionally set TELEGRAM_OWNER_ID (your numeric
# Telegram user id — send /whoami to your bot to learn it, or ask @userinfobot)
# so ONLY you can talk to your assistant.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
DISCORD_TOKEN=
